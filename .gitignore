.venv/
__pycache__/
*.egg-info/
dist/
build/
*.pyc
.pytest_cache/
output/
*.nc
.idea/
reports/published/
# .pbg runtime state, but keep vendored schemas for CI lint
.pbg/*
!.pbg/schemas/


# Added by pbg-superpowers in-place scaffolder
!.pbg/hpc.env.example
investigations/*/runs.db
investigations/*/viz/
investigations/*/.run.lock
workspace/reports/assets/*
!workspace/reports/assets/.keep
.superpowers/brainstorm/

# structural-model: parsimony engine state + large regenerable pack artifacts
# (meshes ~350MB, *.pack.json ~17MB) and the assembled 3D viewer app. All
# regenerate via `sims/run.py` + `python -m viva_mgen.structural.viewer`.
.parsimony/
workspace/studies/*/pack/
workspace/studies/*/viz/viewer/
# Ignore the heavy 3D contents (meshes ~350MB/study, structures/) but COMMIT the
# small pack + meta sidecar: they seed the read-only workbench's saved-viz gallery
# entry and power the local viewer. On the read-only site the meshes are streamed
# from Cloudflare R2 instead (see ui.viz_viewer_urls in workspace.yaml).
workspace/studies/*/viz/3d/*
!workspace/studies/*/viz/3d/*.pack.json
!workspace/studies/*/viz/3d/*.meta.json
